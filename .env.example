# Copy to .env and fill in real values. NEVER commit .env.
# Keep this file ASCII-only (comments in English) to avoid encoding issues on Windows.

APP_ENV=local

# --- LLM ---
# Default model for every task. The provider is picked from the model name:
#   claude-*          -> Anthropic (needs ANTHROPIC_API_KEY)
#   gemini-* / gemma-* -> Google Gemini (needs GEMINI_API_KEY)
#   ollama:<model>    -> local Ollama (compose profile "ollama")
# Per-task overrides live in src/research_scientist/providers/models.py (TASK_ROUTES).
LLM_DEFAULT_MODEL=gemini-4-hydrogen
# Anthropic key: https://platform.claude.com
ANTHROPIC_API_KEY=
# Gemini key: https://aistudio.google.com (free tier data may be used by Google to improve products)
GEMINI_API_KEY=
# Max spend (USD) per workflow run. Gemini has no prices configured yet, so its cost counts as 0.
RUN_BUDGET_USD=2.0

# Second provider for eval comparisons - local Ollama, compose profile "ollama"
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Postgres ---
POSTGRES_USER=ars
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ars
DATABASE_URL=postgresql+asyncpg://ars:change-me-postgres@postgres:5432/ars
# LangGraph checkpointer uses psycopg (no +asyncpg suffix)
CHECKPOINT_DATABASE_URL=postgresql://ars:change-me-postgres@postgres:5432/ars

# --- Redis / Qdrant ---
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=ars-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=papers
MINIO_SECURE=false

# --- AI services (compose profiles "ai" / "rerank") ---
GROBID_URL=http://grobid:8070
TEI_EMBED_URL=http://tei-embed:80
TEI_RERANK_URL=http://tei-rerank:80
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Scholarly APIs ---
# Optional, but without a key Semantic Scholar often returns HTTP 429
SEMANTIC_SCHOLAR_API_KEY=
# Crossref "polite pool": your contact email (optional)
CROSSREF_MAILTO=

# --- Web ---
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
